# RDRS runtime environment. Copy this file to .env.
RDRS_ENV=development
RDRS_HOST=127.0.0.1
RDRS_PORT=8000
RDRS_LOG_LEVEL=INFO
RDRS_DATABASE_URL=sqlite:///./data/rdrs.db
RDRS_CONFIG_PATH=config.yaml
RDRS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Keep this true during all student development/testing.
RDRS_SIMULATION_MODE=true
